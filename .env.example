# ============================================
# CodeSaathi AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit real keys to version control
# ============================================

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenRouter (AI)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001

# Judge0 (Code Execution)
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=your_judge0_api_key

# Limits
MAX_IMAGE_MB=5
MAX_PAGES=10
RUN_RATE_LIMIT_PER_MIN=10
AI_RATE_LIMIT_PER_MIN=10
MAX_EXECUTION_TIME_SEC=5
MAX_MEMORY_MB=128
MAX_OUTPUT_SIZE_KB=64

# JWT Secret (for admin tokens)
JWT_SECRET=your_jwt_secret_here
